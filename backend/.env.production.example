# PRODUCTION TEMPLATE. Placeholders only: copy to the server as `.env`, fill the values there, and never commit the real file.
APP_NAME="ELJIN Employee Portal"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                        # php artisan key:generate --show (generate on the server)
APP_URL=<production-api-url>    # https://...

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<database-host>         # private network address; MySQL must not be reachable from the internet
DB_PORT=3306
DB_DATABASE=eljin_portal
DB_USERNAME=<least-privilege-user>
DB_PASSWORD=<set-on-server>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_DOMAIN=<shared-parent-domain>

SANCTUM_STATEFUL_DOMAINS=<portal-host>      # the exact frontend host (no scheme)
CORS_ALLOWED_ORIGINS=<https://portal-origin> # the exact frontend origin(s); never *

FILESYSTEM_DISK=local           # private disk; uploads are never web-accessible
BCRYPT_ROUNDS=12

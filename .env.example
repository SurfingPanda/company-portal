# Only PUBLIC, frontend-safe values belong in VITE_* variables: they are compiled into the browser bundle and visible to everyone.
# NEVER put passwords, APP_KEY, database credentials, or API secrets here.

# External recruitment system (optional). When set, "Apply Now" opens it in a new tab;
# when empty, the portal's demo application flow is used.
VITE_RECRUITMENT_URL=
VITE_RECRUITMENT_SYSTEM_NAME=

# --- Authentication (Phase 22) -------------------------------------------------------------------
# Laravel backend address. Leave empty for same-origin (production, or a dev proxy).
# Local development example only; do not hard-code this anywhere else:
VITE_API_BASE_URL=
# Development: leave the line above EMPTY. Vite then forwards /api and /sanctum to the Laravel API (VITE_API_PROXY_TARGET, default
# http://127.0.0.1:8001), so the browser makes same-origin calls with no CORS preflight requests.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# "mock" = development-only sign-in without a backend (sample account in AUTHENTICATION.md).
# "api"  = real Laravel session authentication. Production builds ALWAYS use "api", whatever this says.
VITE_AUTH_MODE=mock

# --- Data (Phase 24) -----------------------------------------------------------------------------
# Where feature data comes from. "mock" = local sample data (development only). "api" = Laravel.
# Production builds ALWAYS use "api", whatever this says. Modules not yet migrated (see API.md) still read sample data.
VITE_DATA_MODE=mock
